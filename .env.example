# ============================================================
# Burn Notice Co — environment variables
# ------------------------------------------------------------
# Copy this file to ".env" and edit the values to your real settings.
# Never commit the real .env file — it has secrets.
# ============================================================

# Password for the /admin dashboard. CHANGE THIS.
ADMIN_PASSWORD=changeme

# Long random string used to sign the admin login cookie.
# Smash your keyboard for 40+ characters of letters and numbers.
SESSION_SECRET=replace-this-with-a-long-random-string

# ---------- Stripe payments ----------
# Get these from https://dashboard.stripe.com/test/apikeys (use test keys first).
# When flipping live, swap to sk_live_... and pk_live_... and toggle Apple Pay
# domain verification in Stripe Dashboard → Settings → Payments → Apple Pay.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...

# Webhook signing secret. For local dev, run `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` and copy the whsec_... it prints.
# In production, get it from Dashboard → Developers → Webhooks → your endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# Feature flag — set to "true" to enable Stripe checkout. When "false" (or
# unset), the site falls back to the manual lead-capture flow.
NEXT_PUBLIC_STRIPE_ENABLED=true

# (Later, if you want order emails sent to you)
# RESEND_API_KEY=
# NOTIFY_EMAIL=cammaratabryce@gmail.com
